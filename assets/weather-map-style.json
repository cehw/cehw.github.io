{
  "version": 8,
  "name": "Hong Kong green terrain and blue sea",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "elevation": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "encoding": "terrarium",
      "maxzoom": 15,
      "attribution": "<a href=\"https://github.com/tilezen/joerd/blob/master/docs/attribution.md\">Terrain sources</a>"
    }
  },
  "layers": [
    {
      "id": "land",
      "type": "background",
      "paint": {
        "background-color": "#d4e6b4"
      }
    },
    {
      "id": "urban",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e8e5d9"
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "residential"
      ]
    },
    {
      "id": "grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#b7d894"
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "grass"
      ]
    },
    {
      "id": "forest",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#a8cf84"
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "wood"
      ]
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#b1d58c"
      }
    },
    {
      "id": "relief",
      "type": "hillshade",
      "source": "elevation",
      "paint": {
        "hillshade-exaggeration": 0.45,
        "hillshade-shadow-color": "#557647",
        "hillshade-highlight-color": "#f5f4d6",
        "hillshade-accent-color": "#7c995f",
        "hillshade-illumination-anchor": "map"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#7dbbe3"
      },
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ]
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#7dbbe3",
        "line-width": 1
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary"
          ]
        ]
      ],
      "paint": {
        "line-color": "#fbf8e9",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.8,
          14,
          3
        ]
      }
    },
    {
      "id": "main-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk"
          ]
        ]
      ],
      "paint": {
        "line-color": "#e6b79b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.7,
          14,
          2
        ]
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "city",
            "town",
            "suburb",
            "village"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#526356",
        "text-halo-color": "#f2f4df",
        "text-halo-width": 1.3
      }
    }
  ]
}
